{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/packages/tauri-utils/schema/capability.json",
  "identifier": "default",
  "description": "Default capability set for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/com.notebooklab.app/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/com.notebooklab.app/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/com.notebooklab.app/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/com.notebooklab.app/**" }]
    },
    "updater:default"
  ]
}
