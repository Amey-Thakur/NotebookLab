# Dependencies
node_modules/

# Build output
dist/
target/

# Tauri sidecar binary + shared libraries (fetched by npm run sidecar:download)
src-tauri/binaries/*.exe
src-tauri/binaries/llama-server-*
src-tauri/binaries/libs/
src-tauri/binaries/llama-extract/
src-tauri/binaries/*.zip
!src-tauri/binaries/README.md

# OCR model weights (fetched by npm run models:download); keep the folder + docs
src-tauri/resources/models/ocr/*.rten
!src-tauri/resources/models/ocr/README.md

# Environment
.env
.env.local
.env.*.local

# IDE and local tooling
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Tauri build artifacts
src-tauri/target/
src-tauri/WixTools/
src-tauri/gen/

# Third-party documents
*.pdf
# The field guide is a published deliverable, not a build artifact: the README
# and the site both link to it, so it has to be in the tree.
!docs/notebooklab-handbook.pdf
!docs/press-kit/*.pdf
